{
  "name": "@jonathanyee/ms-decision-mcp",
  "version": "0.1.0",
  "description": "A typed decision API for agents, powered by Microsoft-Decision-1 on Azure.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonyee/ms-decision-mcp.git"
  },
  "homepage": "https://github.com/jonyee/ms-decision-mcp#readme",
  "bugs": { "url": "https://github.com/jonyee/ms-decision-mcp/issues" },
  "keywords": ["mcp", "azure", "microsoft-decision", "agents"],
  "files": ["dist", "README.md", "LICENSE", ".env.example"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": { "ms-decision-mcp": "dist/index.js" },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "test:live": "tsx scripts/smoke.ts",
    "check": "tsc --noEmit"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
