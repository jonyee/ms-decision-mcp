{
  "name": "ms-decision-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A typed decision API for agents, powered by Microsoft-Decision-1 on Azure.",
  "type": "module",
  "bin": { "ms-decision-mcp": "dist/index.js" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
