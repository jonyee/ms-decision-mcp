# Resource base URL, not project URL or /providers/... route
AZURE_DECISION_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_DECISION_DEPLOYMENT=your-deployment-name

# default: DefaultAzureCredential; azure-cli: current az login; api-key: configured key
AZURE_DECISION_AUTH=azure-cli
# AZURE_DECISION_API_KEY=...
AZURE_DECISION_TIMEOUT_MS=30000
